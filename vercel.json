{
  "version": 2,
  "buildCommand": "pnpm --filter inventory-frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}